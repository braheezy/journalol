# Copy this file to .env, then replace the example account values.
# Never commit your real Riot API key.
RIOT_API_KEY=
JOURNALOL_RIOT_GAME_NAME=YourGameName
JOURNALOL_RIOT_TAG_LINE=YourTag
JOURNALOL_RIOT_PLATFORM_ROUTE=NA1

# Usually leave this blank; Journalol derives it from the platform route.
JOURNALOL_RIOT_REGIONAL_ROUTE=

# Up to this many recent matches per supported queue: Normal Draft, Ranked
# Solo/Duo, and Ranked Flex.
JOURNALOL_RIOT_HISTORY_LIMIT=20
JOURNALOL_RIOT_POLL_INTERVAL=5m
JOURNALOL_RIOT_SYNC_ON_START=true

# Keep this false when creating a fresh database for real Riot data.
JOURNALOL_DEMO=false
